name: brockman
version: 5.3.1
license: MIT
author: lassulus <lassulus@lassul.us>, kmein <kmein@posteo.de>
maintainer: kmein <kmein@posteo.de>
build-type: Simple
cabal-version: >=1.10

executable brockman
  hs-source-dirs: src
  main-is: Main.hs
  other-modules: Brockman.Bot, Brockman.Bot.Controller, Brockman.Bot.Reporter, Brockman.Feed, Brockman.Types, Brockman.Util
  build-depends:
    aeson,
    aeson-pretty,
    base,
    bytestring,
    case-insensitive,
    conduit,
    containers,
    directory,
    filepath,
    hashable,
    hslogger,
    html-entity,
    http-client,
    http-client-tls,
    irc-conduit,
    lens,
    lrucache,
    network,
    optparse-applicative,
    random,
    safe,
    text,
    time,
    timerep,
    unordered-containers,
    wreq,
    xeno
  default-language: Haskell2010
  extensions: Strict, ImportQualifiedPost
  -- one mostly sleeping thread per feed: 4 KB stack chunks (default 32 KB) halve memory at 40k feeds (3.1 -> 1.45 GB);
  -- fetching is CPU-bound on brockman.news (aarch64, TLS + parsing): 4 cores do 41k first fetches in ~7 instead of ~80 minutes
  ghc-options: -O2 -Wall -Werror -threaded "-with-rtsopts=-kc4k -N4"
